# -----------------------------------------------------------------------------
# MediCare Clinical Decision Support System - Environment Configuration
# -----------------------------------------------------------------------------

SECRET_KEY=change-in-production-use-a-strong-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Primary Database Configuration: PostgreSQL 16.x
DB_NAME=medicare
DB_USER=medicare
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Fallback alias compatibility for existing scripts
POSTGRES_DB=medicare
POSTGRES_USER=medicare
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Set to 'true' ONLY to run isolated local tests without live PostgreSQL
USE_SQLITE_TESTS=false

# JWT Token Lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Part 2 / Future Integrations
OPENFDA_BASE_URL=https://api.fda.gov/drug
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
DRUGBANK_BASE_URL=
DRUGBANK_API_KEY=
AI_MODEL_PATH=

# Google Gemini API Configuration (Free Tier Model)
# Obtain API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash
